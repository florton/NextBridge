{
  // Toolchain config for the archived variants only.
  // signal-bridge/ is the shipping package and carries its own tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "archive/next-bridge/src",
    "archive/next-bridge/demo12",
    "archive/next-bridge/test",
    "archive/zustand-bridge"
  ]
}
